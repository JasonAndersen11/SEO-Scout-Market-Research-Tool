# Rank & Rent Research System — environment variables
# Copy this file to .env and fill in real keys. Never commit .env.

# Anthropic (Claude) — required for CrewAI agents
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ahrefs API v3 — required for keyword research, city volume/CPC, domain metrics, backlinks
# Create a key: Ahrefs → Account settings → API keys
# Docs: https://docs.ahrefs.com/api/docs/introduction.md
# Use an API v3 key (Bearer token). MCP-scoped keys are for Cursor/Grok Bot, not this app.
AHREFS_API_KEY=your_ahrefs_api_key_here

# Serper — required for Google Maps 3-pack and Ads search
# https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
