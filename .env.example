# Copy this file to .env and paste your keys after the = signs.
# .env is never uploaded to GitHub.

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Semrush — Subscription info > API units in your Semrush account
SEMRUSH_API_KEY=

# Serper (Google search + Maps) — https://serper.dev/api-key
SERPER_API_KEY=
